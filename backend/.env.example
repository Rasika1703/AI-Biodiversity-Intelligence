# Copy to .env and fill in. Everything here has a working default except the API key.

# --- LLM narration (optional but recommended) -----------------------------
# Without a key the reasoning engine still produces full, cited analyses.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-5-20250929
LLM_MAX_TOKENS=2400
LLM_TEMPERATURE=0.25

# --- retrieval ------------------------------------------------------------
USE_CHROMA=true
CHROMA_DIR=./data/chroma
EMBEDDING_BACKEND=auto        # auto | hashing
EMBEDDING_MODEL=all-MiniLM-L6-v2
DENSE_WEIGHT=0.62
LEXICAL_WEIGHT=0.38
TOP_K=7

# --- storage --------------------------------------------------------------
DB_PATH=./data/darukaa.db

# --- server ---------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
